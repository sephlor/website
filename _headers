# Cloudflare Pages security headers.
# This file is read by Pages at deploy time (it is NOT served to visitors).
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  # Don't let the site be framed by other sites (clickjacking).
  X-Frame-Options: DENY
  # Don't leak the full URL as a referrer to other origins.
  Referrer-Policy: strict-origin-when-cross-origin
  # Stop browsers from MIME-sniffing responses.
  X-Content-Type-Options: nosniff
  # Deny powerful features this static site never uses.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  # Force HTTPS for 2 years, including subdomains. Safe once the site is live on
  # HTTPS everywhere. NOTE: this applies to subdomains too — fine for a static
  # site, but if you ever host something on http-only at a subdomain, revisit.
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  # Content Security Policy: everything must come from this origin. No inline
  # scripts, no third-party anything. Tighten/loosen if you add fonts/analytics.
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
